# ---------------------------------------------------------------------------
# Docs Revisions RAG - environment configuration
# Copy to `.env` and adjust. Never commit a real .env file.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info
# Pretty-print logs in development. JSON structured logs when false.
LOG_PRETTY=true

# --- API / Web -------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=3000
WEB_PORT=5173
# Comma separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Simple shared-secret guard for /api/admin/* and /api/debug/*.
# Replace with real authentication before any non-demo deployment.
ADMIN_API_KEY=dev-admin-key
# Requests per minute per IP.
RATE_LIMIT_MAX=240
RATE_LIMIT_WINDOW=1 minute

# --- PostgreSQL ------------------------------------------------------------
# Docker compose default: postgres://rag:rag@localhost:5433/docs_rag
DATABASE_URL=postgres://postgres:postgres@localhost:5432/docs_rag
# Separate database used by the integration test suite. It is truncated freely.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/docs_rag_test
PGPOOL_MAX=10
PGPOOL_IDLE_TIMEOUT_MS=30000
PGPOOL_CONNECTION_TIMEOUT_MS=10000
PG_STATEMENT_TIMEOUT_MS=60000

# --- OpenAI ----------------------------------------------------------------
# Never exposed to the browser. All model calls originate from the API.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_REQUEST_TIMEOUT_MS=60000
OPENAI_REQUEST_CONCURRENCY=4
OPENAI_RETRY_LIMIT=4
CHAT_TEMPERATURE=0.1
CHAT_MAX_OUTPUT_TOKENS=1200

# --- Embeddings ------------------------------------------------------------
# openai | mock
# `mock` produces deterministic, NON-SEMANTIC vectors. Infrastructure/scale
# testing only - never use mock embeddings to report retrieval quality.
EMBEDDING_PROVIDER=openai
# Dimension of the configured embedding model. Must match the value baked into
# the database column by the migrations (see migrations/0002_*).
# text-embedding-3-small = 1536, text-embedding-3-large = 3072.
EMBEDDING_DIMENSIONS=1536
MAX_EMBEDDING_BATCH_SIZE=96
EMBEDDING_INPUT_MAX_TOKENS=8000

# --- Document storage ------------------------------------------------------
# local | (future) s3 | azure-blob | sharepoint
DOCUMENT_STORAGE_DRIVER=local
DOCUMENT_STORAGE_ROOT=./storage/documents

# --- Chunking --------------------------------------------------------------
CHUNK_TARGET_TOKENS=650
CHUNK_MAX_TOKENS=900
CHUNK_MIN_TOKENS=80
CHUNK_OVERLAP_TOKENS=100
# Parent (section-level) chunks used for parent-child retrieval expansion.
PARENT_CHUNKS_ENABLED=true
PARENT_CHUNK_MAX_TOKENS=1800

# --- Retrieval -------------------------------------------------------------
VECTOR_TOP_K=25
LEXICAL_TOP_K=25
RRF_K=60
FINAL_CONTEXT_CHUNKS=8
CONTEXT_TOKEN_BUDGET=6000
# Cosine distance above which a vector candidate is discarded (0..2). 1.0 keeps
# everything with a non-negative cosine similarity.
VECTOR_MAX_DISTANCE=0.95
# noop | (future) cohere | cross-encoder
RERANKER=noop
RETRIEVAL_PARENT_EXPANSION=true
# Persist per-query retrieval traces into retrieval_logs.
RETRIEVAL_LOGGING_ENABLED=true

# --- Chat ------------------------------------------------------------------
# Number of prior turns used to build a standalone retrieval query.
CHAT_HISTORY_TURNS=6
CHAT_HISTORY_TOKEN_BUDGET=1200
QUERY_REWRITE_ENABLED=true

# --- Ingestion -------------------------------------------------------------
# Empty string disables the scheduler. Development example: every minute.
INGESTION_CRON=
INGESTION_RUN_ON_BOOT=false
MAX_DOCUMENTS_PER_INGESTION_RUN=200
INGESTION_CONCURRENCY=4
# Refuse to embed a very large corpus through OpenAI unless explicitly allowed.
ALLOW_LARGE_OPENAI_INGESTION=false
LARGE_OPENAI_INGESTION_THRESHOLD=250

# --- OCR / Vision ----------------------------------------------------------
OCR_ENABLED=true
# tesseract | none
OCR_PROVIDER=tesseract
OCR_LANGUAGE=eng
# A page whose native text layer yields fewer than this many characters (or a
# lower character-per-area density) is treated as scanned and sent to OCR.
OCR_MIN_NATIVE_CHARS=180
OCR_MIN_CHARS_PER_PAGE_AREA=0.0004
OCR_RENDER_SCALE=2.0
OCR_MAX_PAGES_PER_DOCUMENT=40
OCR_CONCURRENCY=2

# Vision enrichment of embedded diagrams/images. Off by default (API cost).
VISION_ENABLED=false
# openai | none
VISION_PROVIDER=openai
VISION_MODEL=gpt-4.1-mini
VISION_MAX_IMAGES_PER_DOCUMENT=6

# --- Debug endpoints -------------------------------------------------------
# /api/debug/* is enabled automatically outside production; set true to force.
ENABLE_DEBUG_ENDPOINTS=false

# --- Synthetic corpus generator -------------------------------------------
# smoke | quality | scale
MOCK_CORPUS_PROFILE=quality
MOCK_CORPUS_SIZE=75
MOCK_CORPUS_SEED=12345
MOCK_SCANNED_RATIO=0.10
MOCK_WORKFLOW_RATIO=0.05
MOCK_MULTI_REVISION_RATIO=0.20
MOCK_CORRUPT_RATIO=0.01
MOCK_INACTIVE_RATIO=0.04
MOCK_DUPLICATE_RATIO=0.03
MOCK_DOCX_RATIO=0.12
MOCK_TEXT_RATIO=0.08
MOCK_TABLE_RATIO=0.25
