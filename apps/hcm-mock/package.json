{
  "name": "@docs-rag/hcm-mock",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Stand-in HCM leave-management service. Implements the published contract so the assistant can be built and tested before the real HCM API is available.",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@docs-rag/hcm-contract": "*",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
