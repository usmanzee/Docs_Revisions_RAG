{
  "name": "@docs-rag/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Fastify API: chat/RAG, document browsing, ingestion control and admin tooling.",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration"
  },
  "dependencies": {
    "@docs-rag/shared": "*",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@langchain/core": "^1.2.9",
    "@langchain/openai": "^1.5.11",
    "@langchain/textsplitters": "^1.0.1",
    "@napi-rs/canvas": "^1.0.8",
    "croner": "^10.0.1",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.3",
    "gpt-tokenizer": "^4.0.0",
    "mammoth": "^1.12.2",
    "openai": "^7.10.0",
    "p-limit": "^7.3.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "tesseract.js": "^7.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
